{
  "headers": [
    {
      "source": "/rinkhockeyIL.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"rinkhockeyIL.apk\"" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },

    { "source": "/games/:id([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/tv", "destination": "/api/resolve?type=games&id=:id&suffix=tv" },
    { "source": "/players/:id([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})", "destination": "/api/resolve?type=players&id=:id" },
    { "source": "/teams/:id([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})", "destination": "/api/resolve?type=teams&id=:id" },
    { "source": "/games/:id([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})", "destination": "/api/resolve?type=games&id=:id" },
    { "source": "/tournaments/:id([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})", "destination": "/api/resolve?type=tournaments&id=:id" },

    {
      "source": "/players/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|Slackbot|LinkedInBot|TelegramBot|Discordbot|Pinterest|redditbot|Embedly|vkShare|Applebot|SkypeUriPreview|W3C_Validator).*" }],
      "destination": "/api/og?type=players&id=:id"
    },
    {
      "source": "/teams/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|Slackbot|LinkedInBot|TelegramBot|Discordbot|Pinterest|redditbot|Embedly|vkShare|Applebot|SkypeUriPreview|W3C_Validator).*" }],
      "destination": "/api/og?type=teams&id=:id"
    },
    {
      "source": "/games/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|Slackbot|LinkedInBot|TelegramBot|Discordbot|Pinterest|redditbot|Embedly|vkShare|Applebot|SkypeUriPreview|W3C_Validator).*" }],
      "destination": "/api/og?type=games&id=:id"
    },
    {
      "source": "/tournaments/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|Slackbot|LinkedInBot|TelegramBot|Discordbot|Pinterest|redditbot|Embedly|vkShare|Applebot|SkypeUriPreview|W3C_Validator).*" }],
      "destination": "/api/og?type=tournaments&id=:id"
    },

    {
      "//": "SPA fallback \u2014 but NOT for /assets/. Vercel serves an existing static file before any rewrite, so real bundles are unaffected; this only changes what happens when the file is MISSING. Without the exclusion a stale tab asking for a bundle that a redeploy replaced got 200 + index.html, which the browser reports as \"MIME type ('text/html') is not a supported stylesheet\" \u2014 and a missing JS chunk came back as HTML and died with a syntax error. Now it 404s honestly.",
      "source": "/((?!assets/).*)",
      "destination": "/"
    }
  ]
}
